{
  "name": "@mentra/recorder",
  "version": "1.0.0",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build:webview": "bun run build.ts",
    "prebuild": "bun run build:webview",
    "start": "bun run build:webview && NODE_ENV=development bun src/index.ts",
    "start:prod": "bun run build:webview && NODE_ENV=production bun src/index.ts",
    "ngrok": "ngrok http --url=isaiah-tpa.ngrok.app 8069",
    "image:build": "docker build -t mentra/recorder:latest -t mentra/recorder:$npm_package_version -f docker/Dockerfile .",
    "image:push": "docker push mentra/recorder:latest && docker push mentra/recorder:$npm_package_version",
    "image:release": "npm run image:build && npm run image:push",
    "ghcr:build": "docker build -t ghcr.io/mentra/recorder:latest -t ghcr.io/mentra/recorder:$npm_package_version -f docker/Dockerfile .",
    "ghcr:push": "docker push ghcr.io/mentra/recorder:latest && docker push ghcr.io/mentra/recorder:$npm_package_version",
    "ghcr:release": "npm run ghcr:build && npm run ghcr:push"
  },
  "dependencies": {
    "@mentra/sdk": "^2.1.29-beta.2",
    "@mentra/react": "^0.2.0",
    "@aws-sdk/client-s3": "^3.812.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "axios": "^1.8.1",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "lucide-react": "^0.476.0",
    "mongoose": "^8.15.0",
    "next-themes": "^0.4.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.10.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@types/uuid": "^9.0.8",
    "tailwindcss": "^4.0.8",
    "typescript": "^5.3.3"
  }
}
